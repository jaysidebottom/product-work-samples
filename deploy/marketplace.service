[Unit]
Description=Controlled Marketplace demo
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=marketplace
Group=marketplace
WorkingDirectory=/opt/marketplace/current
EnvironmentFile=/etc/marketplace/private.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /opt/marketplace/current/projects/marketplace/app.py --host 127.0.0.1 --port 8766 --db /var/lib/marketplace/marketplace.sqlite3
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/marketplace
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
